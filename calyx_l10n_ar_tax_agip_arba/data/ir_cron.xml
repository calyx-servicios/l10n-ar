<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_update_padron_next_month" model="ir.cron">
        <field name="name">Calyx: actualizar padrón mes siguiente (partners activos)</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_padron_next_month(next_month=True)</field>
        <field name="nextcall" eval="(datetime.now().replace(day=29, hour=3, minute=0, second=0, microsecond=0) if datetime.now().day &lt;= 29 else (datetime.now() + timedelta(days=32)).replace(day=29, hour=3, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="ir_cron_update_padron_current_month_manual_test" model="ir.cron">
        <field name="name">Calyx: Test Padrón</field>
        <field name="active">False</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_padron_selected_month(test_year=2026, test_month=4)</field>
    </record>
</odoo>
