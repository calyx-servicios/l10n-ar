<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view"
            id="view_partner_form_padron_button">
        <field name="name">
            res.partner.form.inherit.l10n_ar_tax_agip_arba
        </field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_ar_tax.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_ar_partner_perception_ids']/.."
                   position="before">
                <div class="d-flex justify-content-end mb-2"
                     invisible="country_code != 'AR'">
                    <button name="action_update_padron"
                            type="object"
                            string="Actualizar Padrón"
                            class="oe_highlight"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
