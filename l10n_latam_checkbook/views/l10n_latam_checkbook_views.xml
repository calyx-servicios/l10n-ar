<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_checkbook_tree" model="ir.ui.view">
        <field name="name">l10n_latam.checkbook.list</field>
        <field name="model">l10n_latam.checkbook</field>
        <field name="arch" type="xml">
            <list string="Checkbooks" decoration-muted="not active" editable="bottom">
                <field name="type"/>
                <field name="range_from" invisible="type == 'electronic'"/>
                <field name="next_number" invisible="type == 'electronic'"/>
                <field name="range_to" invisible="type == 'electronic'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

</odoo>
