<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_city_tree_unique_code" model="ir.ui.view">
        <field name="name">res.city.list.unique.code</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="unique_code"/>
            </field>
            <field name="zipcode" position="after">
                <field name="afip_code" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
