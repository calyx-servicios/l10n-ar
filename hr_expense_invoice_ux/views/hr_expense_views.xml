<odoo>

    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.form.hr_expense_invoice_ux</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense_invoice_calyx.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <!-- Administración carga la factura una vez aprobado el gasto -->
            <button name="action_expense_create_invoice" position="attributes">
                <attribute name="invisible">invoice_id or state != 'approved'</attribute>
            </button>
            <field name="invoice_id" position="attributes">
                <attribute name="readonly">state != 'approved'</attribute>
            </field>
            <field name="invoice_id" position="after">
                <field name="approved_amount"
                       invisible="not approved_amount"
                       groups="account.group_account_readonly"/>
            </field>
        </field>
    </record>

</odoo>
