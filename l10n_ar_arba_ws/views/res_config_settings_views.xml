<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.l10n_ar_arba_ws</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ar.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='argentina_localization']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="l10n_ar_arba_wh_mode" string="Webservice Retenciones (A122R)"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ar_arba_wh_mode" class="col-lg-3 o_light_label" string="Mode"/>
                                <field name="l10n_ar_arba_wh_mode"/>
                            </div>
                            <div class="row mt16">
                                <label for="l10n_ar_arba_dj_period" class="col-lg-3 o_light_label" string="Periodicity"/>
                                <field name="l10n_ar_arba_dj_period"/>
                            </div>
                            <div class="row mt16">
                                <label for="l10n_ar_arba_env" class="col-lg-3 o_light_label" string="Environment"/>
                                <field name="l10n_ar_arba_env" widget="radio"/>
                            </div>
                            <div class="row mt16" attrs="{'invisible': [('l10n_ar_arba_env', '=', 'demo')]}">
                                <label for="l10n_ar_arba_client_id" class="col-lg-3 o_light_label" string="Client ID"/>
                                <field name="l10n_ar_arba_client_id"/>
                            </div>
                            <div class="row mt16" attrs="{'invisible': [('l10n_ar_arba_env', '=', 'demo')]}">
                                <label for="l10n_ar_arba_client_secret" class="col-lg-3 o_light_label" string="Secret"/>
                                <field name="l10n_ar_arba_client_secret" password="True"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
